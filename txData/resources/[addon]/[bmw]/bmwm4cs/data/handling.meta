<?xml version="1.0" encoding="UTF-8"?>

<!--
  handling.meta — BMW M4 CS (F82) — bmwm4cs
  Profil: GTA_GOOD_FEEL_RWD — podobny feeling do gt63s, ale agresywne czyste RWD

  Dane techniczne (BMW M4 CS F82):
    Masa:        1580 kg
    Moment:      600 Nm @ 4000 rpm
    Moc:         460 KM
    Vmax:        280 km/h (elektronicznie ograniczone)
    Napęd:       RWD (czyste tylnonapędowe — zachowane, to DNA tego auta)
    Skrzynia:    7-biegowa DCT (M Double Clutch)
    Opony:       265/35 R20 (przód) / 285/30 R20 (tył)

  Co zmieniono względem oryginału i dlaczego:
    fTractionCurveMin:       2.550 → 3.300  (> Max) → samostabilizacja jak gt63s/tenf
    fBrakeForce:             0.900 → 3.400  → pewne hamowanie GTA jak Mercedes
    fInitialDriveMaxFlatVel: 210.0 → 210.0  (280 × 0.75 = 210 — już było OK)
    fLowSpeedTractionLossMult: 0.450 → 0.850  (agresywny RWD wheelspin, ale kontrolowalny)
    fAntiRollBarForce:       0.850 → 1.150  (płasko, ale nie betonowo)
    fAntiRollBarBiasFront:   0.580 → 0.560  (stabilny przód, tył dalej żywy)
    fRollCentreHeightFront:  0.300 → 0.320  (wyżej = płaściej jak w Audi/Mercedesie)
    fRollCentreHeightRear:   0.300 → 0.300  (zachowane — tył RWD potrzebuje trochę ruchu)
    fTractionBiasFront:      0.475 → 0.460  (większy bias tył — RWD charakter)
    fTractionLossMult:       1.000 → 1.000  (standard GTA)
    fClutchChangeRate:       6/5   → 7/6.5  (szybkie, ale nie teleportujące biegi)
    fInitialDriveForce:      0.330 → 0.390  (agresywne przyspieszenie RWD)
    fDriveInertia:           1.150 → 1.300  (ostrzejsza odpowiedź na gaz)
    AIHandling:              AVERAGE → SPORTS_CAR
    strHandlingFlags:        0 → 20002  (jak Mercedes — poprawia zachowanie AI i fizyki)
-->

<CHandlingDataMgr>
  <HandlingData>
    <Item type="CHandlingData">
      <handlingName>bmwm4cs</handlingName>

      <!-- Realna masa BMW M4 CS F82 -->
      <fMass value="1580.000000" />

      <!-- Drag: zachowany z oryginału (6.0 = dobra wartość dla sportowego coupe) -->
      <fInitialDragCoeff value="6.500000" />

      <fPercentSubmerged value="85.000000" />

      <!-- Niższy środek ciężkości: po podbiciu auto ma zgubić trakcję, nie przewracać się bokiem -->
      <vecCentreOfMassOffset x="0.000000" y="-0.035000" z="-0.120000" />

      <!-- Większy roll inertia: buda wolniej przechodzi w rolkę po krawężniku/podbiciu -->
      <vecInertiaMultiplier x="1.300000" y="1.900000" z="1.800000" />

      <!-- RWD — zachowane. To DNA BMW M4 CS. AWD zepsułoby charakter auta -->
      <fDriveBiasFront value="0.000000" />

      <!-- 7-biegowa DCT M Double Clutch -->
      <nInitialDriveGears value="7" />

      <!-- Więcej ciągu na wyjściu z zakrętu, żeby auto nie traciło prędkości w slajdzie -->
      <fInitialDriveForce value="0.316456" />

      <!-- DCT: szybka reakcja i szybkie zmiany, podobny feeling do gt63s -->
      <fDriveInertia value="1.300000" />
      <fClutchChangeRateScaleUpShift value="7.000000" />
      <fClutchChangeRateScaleDownShift value="6.500000" />

      <!-- 280 km/h × 0.75 = 210 — zachowane, było poprawne -->
      <fInitialDriveMaxFlatVel value="185.000000" />

      <!-- GTA_GOOD_FEEL: mocne, pewne hamowanie jak w gt63s, ale trochę lżejsze dla M4 -->
      <fBrakeForce value="0.916456" />
      <fBrakeBiasFront value="0.500000" />
      <fHandBrakeForce value="0.600000" />

      <!-- Nadal agresywny, ale bez gwałtownego łapania bocznego gripa -->
      <fSteeringLock value="40.000000" />

      <!-- RWD: nadal puszcza bokiem, ale ma więcej przyczepności w poślizgu na wyjściu -->
      <fTractionCurveMax value="2.397342" />
      <fTractionCurveMin value="2.147342" />

      <fTractionCurveLateral value="21.500000" />
      <fTractionSpringDeltaMax value="0.150000" />

      <!-- Dalej lata bokiem, ale mniej mieli prędkość przy wyjściu z zakrętu -->
      <fLowSpeedTractionLossMult value="1.100000" />
      <fCamberStiffnesss value="0.000000" />

      <!-- Więcej rotacji tyłu, żeby auto odpuszczało gazem zamiast łapać bokiem -->
      <fTractionBiasFront value="0.485000" />

      <fTractionLossMult value="1.000000" />

      <!-- Zawieszenie: zachowane z oryginału — proporcje są już dobre (comp/rebound) -->
      <fSuspensionForce value="2.900000" />
      <fSuspensionCompDamp value="1.450000" />
      <fSuspensionReboundDamp value="2.050000" />

      <fSuspensionUpperLimit value="0.060000" />
      <fSuspensionLowerLimit value="-0.110000" />
      <fSuspensionRaise value="0.000000" />
      <fSuspensionBiasFront value="0.500000" />

      <!-- Mocniej trzyma budę po podbiciu, ale grip opon jest niższy, więc auto idzie bokiem -->
      <fAntiRollBarForce value="0.700000" />
      <fAntiRollBarBiasFront value="0.600000" />

      <!-- Niższy roll center zmniejsza efekt katapultowania auta na bok po nierównościach -->
      <fRollCentreHeightFront value="0.350000" />
      <fRollCentreHeightRear value="0.350000" />

      <!-- Standard RP -->
      <fCollisionDamageMult value="0.700000" />
      <fWeaponDamageMult value="1.000000" />
      <fDeformationDamageMult value="0.700000" />
      <fEngineDamageMult value="1.000000" />

      <fPetrolTankVolume value="80.000000" />
      <fOilVolume value="5.500000" />

      <fSeatOffsetDistX value="0.000000" />
      <fSeatOffsetDistY value="0.000000" />
      <fSeatOffsetDistZ value="0.000000" />

      <nMonetaryValue value="35000" />

      <strModelFlags>440010</strModelFlags>
      <!-- Poprawione: dodane flagi jak w Mercedesie (poprawa fizyki i zachowania AI) -->
      <strHandlingFlags>20002</strHandlingFlags>
      <strDamageFlags>0</strDamageFlags>
      <AIHandling>SPORTS_CAR</AIHandling>

      <SubHandlingData>
        <Item type="CCarHandlingData">
          <fBackEndPopUpCarImpulseMult value="0.100000" />
          <fBackEndPopUpBuildingImpulseMult value="0.030000" />
          <fBackEndPopUpMaxDeltaSpeed value="0.600000" />
        </Item>
        <Item type="NULL" />
        <Item type="NULL" />
      </SubHandlingData>
    </Item>
  </HandlingData>
</CHandlingDataMgr>
